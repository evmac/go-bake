suite ci {
  format.check
  test.cover
}

suite precommit {
  build
  format
  test.no-cache
}

target act {
  desc "run GitHub Actions workflow locally with act (requires Docker + act)"
  steps { exec ["act", "workflow_dispatch"] }
  preset trunk {
    desc "run push-to-trunk workflow locally with act"
    steps { exec ["act", "push"] }
  }
  preset pr {
    desc "run pr-submission workflow locally with act"
    steps { exec ["act", "pull_request"] }
  }
}

target baked {
  desc "build the baked daemon"
  inputs ["./cmd/baked/*.go", "./internal/*/*.go", "go.mod", "go.sum"]
  outputs ["bin/baked"]
  steps { exec ["go", "build", "-o", "bin/baked", "./cmd/baked"] }
}

target build {
  desc "build the bake binary"
  inputs ["./cmd/bake/*.go", "./internal/*/*.go", "go.mod", "go.sum"]
  outputs ["bin/bake"]
  steps { exec ["go", "build", "-o", "bin/bake", "./cmd/bake"] }
}

target format {
  desc "format Go code (go fmt ./...)"
  steps { exec ["go", "fmt", "./..."] }
  preset check {
    desc "check code formatting (no auto-fix)"
    steps { exec ["gofmt", "-l", "."] }
  }
}

target list {
  desc "list targets (alias for --list)"
  steps { exec ["go", "run", "./cmd/bake", "--list"] }
}

target test {
  desc "run tests"
  deps build
  steps { exec ["go", "test", "./..."] }
  preset cover {
    desc "run tests with coverage (produces coverage.out)"
    steps { exec ["go", "test", "./...", "--count=1", "-coverprofile=coverage.out"] }
  }
  preset no-cache {
    desc "run tests without cache"
    steps { exec ["go", "test", "./...", "-count=1"] }
  }
  preset race {
    desc "run tests with race condition detector"
    steps { exec ["go", "test", "./...", "-race"] }
  }
}
