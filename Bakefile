target build {
  desc "build the bake binary"
  inputs [ "./cmd/bake/*.go", "go.mod", "go.sum" ]
  outputs [ "bin/bake" ]
  exec ["go", "build", "-o", "bin/bake", "./cmd/bake"]
}

target test {
  desc "run tests"
  deps build
  exec ["go", "test", "./..."]
}

target test-cover {
  desc "run tests with coverage (produces coverage.out)"
  deps build
  exec ["go", "test", "./...", "-coverprofile=coverage.out"]
}

target format {
  desc "format Go code (go fmt ./...)"
  exec ["go", "fmt", "./..."]
}

target list {
  desc "list targets (alias for --list)"
  steps { exec ["go", "run", "./cmd/bake", "--list"] }
}

suite local {
  build format test
}

suite ci {
  build test-cover
}
